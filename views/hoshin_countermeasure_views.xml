<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Opened from the owner's To-Do when a Hoshin metric is off target two months running. -->
    <record id="view_strategic_hoshin_countermeasure_form" model="ir.ui.view">
        <field name="name">strategic.hoshin.countermeasure.form</field>
        <field name="model">strategic.hoshin.countermeasure</field>
        <field name="arch" type="xml">
            <form string="Countermeasure" create="false" delete="false">
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group><field name="kpi_id" readonly="1"/><field name="red_months" readonly="1"/></group>
                        <group><field name="owner_id" readonly="1"/><field name="due_date"/></group>
                    </group>
                    <group string="Why it is off target"><field name="cause" nolabel="1" colspan="2" placeholder="What caused it?"/></group>
                    <group string="Countermeasure"><field name="action" nolabel="1" colspan="2" placeholder="What will be done, by whom?"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
