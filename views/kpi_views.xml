<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_strategic_kpi_definition_list" model="ir.ui.view">
        <field name="name">strategic.kpi.definition.list</field>
        <field name="model">strategic.kpi.definition</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="unit"/>
                <field name="direction"/>
                <field name="source_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- KPI definition version views. The action is declared before the KPI form
         because the form button references its external ID. -->
    <record id="view_strategic_kpi_definition_version_list" model="ir.ui.view">
        <field name="name">strategic.kpi.definition.version.list</field>
        <field name="model">strategic.kpi.definition.version</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="name"/>
                <field name="kpi_id"/>
                <field name="version_number"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="direction"/>
                <field name="unit"/>
                <field name="source_type"/>
                <field name="state"/>
                <field name="approved_by_id"/>
                <field name="approved_at"/>
            </list>
        </field>
    </record>

    <record id="view_strategic_kpi_definition_version_form" model="ir.ui.view">
        <field name="name">strategic.kpi.definition.version.form</field>
        <field name="model">strategic.kpi.definition.version</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button name="action_approve"
                            string="Approve Version"
                            type="object"
                            class="btn-primary"
                            groups="strategic_management.group_strategic_head_office_manager"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="kpi_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="version_number" readonly="1"/>
                        </group>
                        <group>
                            <field name="effective_from" readonly="state == 'approved'"/>
                            <field name="effective_to" readonly="1"/>
                            <field name="direction" readonly="state == 'approved'"/>
                            <field name="unit" readonly="state == 'approved'"/>
                            <field name="source_type" readonly="state == 'approved'"/>
                        </group>
                    </group>
                    <group>
                        <field name="change_reason" readonly="state == 'approved'"/>
                        <field name="description" readonly="state == 'approved'"/>
                    </group>
                    <group string="Audit Information">
                        <group>
                            <field name="created_by_id" readonly="1"/>
                            <field name="created_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluations">
                            <field name="evaluation_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="status"/>
                                    <field name="attainment_status"/>
                                    <field name="evaluated_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_strategic_kpi_definition_version" model="ir.actions.act_window">
        <field name="name">KPI Definition Versions</field>
        <field name="res_model">strategic.kpi.definition.version</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kpi_id', '=', active_id)]</field>
        <field name="context">{'default_kpi_id': active_id}</field>
    </record>

    <!-- KPI baseline views and action. Baselines are distinct from targets. -->
    <record id="view_strategic_kpi_baseline_list" model="ir.ui.view">
        <field name="name">strategic.kpi.baseline.list</field>
        <field name="model">strategic.kpi.baseline</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="name"/>
                <field name="kpi_id"/>
                <field name="definition_version_id"/>
                <field name="scope"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <field name="baseline_value"/>
                <field name="source_period_start"/>
                <field name="source_period_end"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="state"/>
                <field name="approved_by_id"/>
                <field name="approved_at"/>
            </list>
        </field>
    </record>

    <record id="view_strategic_kpi_baseline_form" model="ir.ui.view">
        <field name="name">strategic.kpi.baseline.form</field>
        <field name="model">strategic.kpi.baseline</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button name="action_approve"
                            string="Approve Baseline"
                            type="object"
                            class="btn-primary"
                            groups="strategic_management.group_strategic_head_office_manager"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="kpi_id" readonly="1"/>
                            <field name="definition_version_id"
                                   domain="[('kpi_id', '=', kpi_id), ('state', '=', 'approved')]"
                                   readonly="1"
                                   force_save="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="scope" readonly="state == 'approved'"/>
                        </group>
                        <group>
                            <field name="warehouse_id" invisible="scope != 'branch'" readonly="state == 'approved'"/>
                            <field name="user_id" invisible="scope != 'user'" readonly="state == 'approved'"/>
                            <field name="baseline_value" readonly="state == 'approved'"/>
                            <field name="source_period_start" readonly="state == 'approved'"/>
                            <field name="source_period_end" readonly="state == 'approved'"/>
                            <field name="effective_from" readonly="state == 'approved'"/>
                            <field name="effective_to" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="source_note" readonly="state == 'approved'"/>
                        <field name="change_reason" readonly="state == 'approved'"/>
                    </group>
                    <group string="Approval Audit">
                        <group>
                            <field name="created_by_id" readonly="1"/>
                            <field name="created_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Linked Targets">
                            <field name="target_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="target_basis"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="target_value"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_strategic_kpi_baseline" model="ir.actions.act_window">
        <field name="name">KPI Baselines</field>
        <field name="res_model">strategic.kpi.baseline</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kpi_id', '=', active_id)]</field>
        <field name="context">{'default_kpi_id': active_id}</field>
    </record>

    <record id="view_strategic_kpi_definition_form" model="ir.ui.view">
        <field name="name">strategic.kpi.definition.form</field>
        <field name="model">strategic.kpi.definition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_strategic_kpi_definition_version)d"
                            string="Manage Definition Versions"
                            type="action"
                            class="btn-secondary"
                            groups="strategic_management.group_strategic_head_office_manager"
                            context="{'default_kpi_id': id}"/>
                    <button name="%(action_strategic_kpi_baseline)d"
                            string="Manage KPI Baselines"
                            type="action"
                            class="btn-secondary"
                            groups="strategic_management.group_strategic_head_office_manager"
                            context="{'default_kpi_id': id}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="unit" readonly="1"/>
                            <field name="direction" readonly="1"/>
                            <field name="source_type" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" readonly="1"/>
                        </page>
                        <page string="Definition Versions">
                            <field name="version_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="version_number"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="direction"/>
                                    <field name="unit"/>
                                    <field name="source_type"/>
                                    <field name="state"/>
                                    <field name="approved_by_id"/>
                                    <field name="approved_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Targets">
                            <field name="target_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="target_basis"/>
                                    <field name="baseline_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="target_value"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Baselines">
                            <field name="baseline_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="scope"/>
                                    <field name="warehouse_id"/>
                                    <field name="user_id"/>
                                    <field name="baseline_value"/>
                                    <field name="source_period_start"/>
                                    <field name="source_period_end"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evaluations">
                            <field name="evaluation_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_strategic_kpi_definition" model="ir.actions.act_window">
        <field name="name">KPI Definitions</field>
        <field name="res_model">strategic.kpi.definition</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_strategic_kpi_target_list" model="ir.ui.view">
        <field name="name">strategic.kpi.target.list</field>
        <field name="model">strategic.kpi.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kpi_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="scope"/>
                <field name="target_basis"/>
                <field name="baseline_id"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <field name="target_value"/>
                <field name="range_min"/>
                <field name="range_max"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_strategic_kpi_target_form" model="ir.ui.view">
        <field name="name">strategic.kpi.target.form</field>
        <field name="model">strategic.kpi.target</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"/>
                    <button name="action_archive" string="Archive" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="kpi_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="scope"/>
                            <field name="target_basis"/>
                            <field name="baseline_id"
                                   domain="[('kpi_id', '=', kpi_id), ('state', '=', 'approved'), ('scope', '=', scope)]"
                                   invisible="target_basis != 'baseline_relative'"/>
                        </group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="user_id"/>
                            <field name="target_value"/>
                            <field name="range_min"/>
                            <field name="range_max"/>
                            <field name="unit"/>
                        </group>
                    </group>
                    <field name="evaluation_ids" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_strategic_kpi_target" model="ir.actions.act_window">
        <field name="name">KPI Targets</field>
        <field name="res_model">strategic.kpi.target</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_strategic_kpi_evaluation_list" model="ir.ui.view">
        <field name="name">strategic.kpi.evaluation.list</field>
        <field name="model">strategic.kpi.evaluation</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="name"/>
                <field name="kpi_id"/>
                <field name="definition_version_id"/>
                <field name="target_basis"/>
                <field name="baseline_id"/>
                <field name="baseline_value"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="scope"/>
                <field name="actual_value"/>
                <field name="target_value"/>
                <field name="attainment"/>
                <field name="attainment_status"/>
                <field name="status"/>
                <field name="evaluated_at"/>
            </list>
        </field>
    </record>

    <record id="view_strategic_kpi_evaluation_form" model="ir.ui.view">
        <field name="name">strategic.kpi.evaluation.form</field>
        <field name="model">strategic.kpi.evaluation</field>
        <field name="arch" type="xml">
            <!-- Do not disable form edit mode here: Odoo needs it to show Save/Discard
                 while creating a new evaluation. Model-level write protection keeps
                 historical evaluation data immutable after creation. -->
            <form delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="kpi_id"/>
                            <field name="definition_version_id" readonly="1"/>
                            <field name="target_basis" readonly="1"/>
                            <field name="baseline_id" readonly="1"/>
                            <field name="baseline_value" readonly="1" invisible="target_basis != 'baseline_relative'"/>
                            <field name="target_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="scope"/>
                            <field name="warehouse_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="actual_value"/>
                            <field name="has_actual_value"/>
                            <field name="target_value"/>
                            <field name="range_min"/>
                            <field name="range_max"/>
                            <field name="unit"/>
                            <field name="gap"/>
                            <field name="attainment"/>
                            <field name="status"/>
                            <field name="attainment_status"/>
                        </group>
                    </group>
                    <group>
                        <field name="source_model"/>
                        <field name="source_record_ref"/>
                        <field name="reason"/>
                        <field name="evaluated_at"/>
                        <field name="evaluated_by_id"/>
                        <field name="superseded_by_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_strategic_kpi_evaluation" model="ir.actions.act_window">
        <field name="name">KPI Evaluations</field>
        <field name="res_model">strategic.kpi.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
