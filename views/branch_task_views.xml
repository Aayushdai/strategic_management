<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Head Office assigns and reviews branch tasks here (e.g. a task for a Branch Manager); branch staff use the app's
         My Tasks and Task Management pages. The model enforces who may assign, work, review and cancel. -->
    <record id="view_strategic_branch_task_list" model="ir.ui.view">
        <field name="name">strategic.branch.task.list</field>
        <field name="model">strategic.branch.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('done', 'cancelled')">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="warehouse_id"/>
                <field name="date_deadline"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge" decoration-warning="state == 'submitted'" decoration-success="state == 'done'"/>
                <field name="is_overdue" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_strategic_branch_task_form" model="ir.ui.view">
        <field name="name">strategic.branch.task.form</field>
        <field name="model">strategic.branch.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept" type="object" string="Accept" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_request_changes" type="object" string="Request Changes" invisible="state != 'submitted'"/>
                    <button name="action_cancel" type="object" string="Cancel Task" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,in_progress,submitted,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="id and state in ('done', 'cancelled')"/>
                            <field name="assigned_user_id" readonly="id" domain="[('share', '=', False), ('strategic_branch_warehouse_id', '!=', False)]" options="{'no_create': True}"/>
                            <field name="warehouse_id" invisible="not id"/>
                            <field name="date_deadline" readonly="id and state in ('done', 'cancelled')"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="objective_id" options="{'no_create': True}"/>
                            <field name="assigned_by_id" invisible="not id"/>
                            <field name="is_overdue" invisible="not is_overdue"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What needs to be done"/>
                    <group invisible="not completion_note and state != 'submitted'">
                        <field name="completion_note"/>
                        <field name="review_note" readonly="state != 'submitted'" placeholder="Required before requesting changes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_strategic_branch_task" model="ir.actions.act_window">
        <field name="name">Branch Tasks</field>
        <field name="res_model">strategic.branch.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', '=', allowed_company_ids[0])]</field>
    </record>

    <menuitem id="menu_strategic_branch_task"
              name="Branch Tasks"
              parent="menu_strategic_management_strategy"
              action="action_strategic_branch_task"
              sequence="40"
              groups="strategic_management.group_strategic_head_office_manager"/>
</odoo>
