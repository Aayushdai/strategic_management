<?xml version="1.0" encoding="UTF-8"?>
<!-- People overview and roles. Called from strategic_management.NavigationShell. -->
<templates xml:space="preserve">
    <t t-name="strategic_management.PeoplePage">
    <div class="o_sm_people_ui">
        <t t-set="pp" t-value="this.state.peopleData"/>
        <header class="o_sm_people_header">
            <div class="o_sm_people_title_block">
                <h1>People</h1>
                <p t-if="pp and pp.role === 'employee'">Your attendance and assigned follow-ups.</p>
                <p t-else="">Understand staffing, attendance, and responsibilities across your café branches.</p>
                <span class="o_sm_people_preview_note"><svg class="o_sm_people_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/></svg> Live Odoo data · updates automatically</span>
            </div>
            <div class="o_sm_pur_filters">
                <label class="o_sm_pur_filter">From <input type="date" t-att-value="this.state.dateStart" t-att-max="this.state.todayDate" t-on-change="this.onStartDateChanged" aria-label="People start date"/></label>
                <label class="o_sm_pur_filter">To <input type="date" t-att-value="this.state.dateEnd" t-att-max="this.state.todayDate" t-on-change="this.onEndDateChanged" aria-label="People end date"/></label>
                <label t-if="pp and pp.role === 'head_office'" class="o_sm_pur_filter">Branch <select t-att-value="this.branchSelectValue" t-on-change="this.onWarehouseChanged" aria-label="People branch filter"><option value="all">All Branches</option><t t-foreach="pp.branch_options" t-as="branch" t-key="branch.id"><option t-att-value="branch.id"><t t-esc="branch.name"/></option></t></select></label>
            </div>
        </header>

        <t t-if="this.isHeadOffice"><t t-call="strategic_management.PeopleRoles"/></t>
        <div t-if="this.state.peopleLoading" class="o_sm_br_notice">Loading live people data…</div>
        <t t-if="!this.state.peopleLoading and pp">
            <div t-foreach="pp.messages or []" t-as="message" t-key="message_index" class="o_sm_br_notice"><t t-esc="message"/></div>
        </t>

        <t t-if="pp and pp.summary">
            <section class="o_sm_people_summary" aria-label="Workforce summary">
                <article class="o_sm_people_metric">
                    <div class="o_sm_people_metric_icon o_sm_people_blue"><svg class="o_sm_people_metric_svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20v-1.4a6 6 0 0 1 12 0V20Z"/><path d="M16 5.5a3 3 0 0 1 0 5.8M18 14a5 5 0 0 1 3 4.6V20h-4"/></svg></div>
                    <div class="o_sm_people_metric_copy"><span>Active Employees</span><strong><t t-esc="pp.summary.active_employees"/></strong><small><t t-esc="pp.sources.employees === 'hr.employee' ? 'Employees app records' : 'Internal users (Employees app not installed)'"/></small></div>
                </article>
                <article class="o_sm_people_metric">
                    <div class="o_sm_people_metric_icon o_sm_people_amber"><svg class="o_sm_people_metric_svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
                    <div class="o_sm_people_metric_copy"><span>Attendance Exceptions</span><strong><t t-esc="pp.summary.attendance_exceptions === false ? 'Not Configured' : pp.summary.attendance_exceptions"/></strong><small>Late arrivals and absences</small></div>
                </article>
                <article class="o_sm_people_metric">
                    <div class="o_sm_people_metric_icon o_sm_people_red"><svg class="o_sm_people_metric_svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21V5l9-3 9 3v16M8 21v-5h8v5"/></svg></div>
                    <div class="o_sm_people_metric_copy"><span>Branches Need Coverage</span><strong><t t-esc="pp.summary.branches_needing_coverage === false ? 'Not Configured' : pp.summary.branches_needing_coverage"/></strong><small>Below planned staff</small></div>
                </article>
                <article class="o_sm_people_metric">
                    <div class="o_sm_people_metric_icon o_sm_people_purple"><svg class="o_sm_people_metric_svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4.5" width="14" height="17" rx="2"/><path d="M9 4.5v-2h6v2M8 11l2 2 4-4M8 17h8"/></svg></div>
                    <div class="o_sm_people_metric_copy"><span>Overdue Staff Tasks</span><strong><t t-esc="pp.summary.overdue_tasks"/></strong><small>Activities past their due date</small></div>
                </article>
            </section>

            <article t-if="pp.insights.length" class="o_sm_people_panel">
                <div class="o_sm_people_panel_heading"><h2>Business Insights</h2><span class="o_sm_people_panel_hint">From the records below</span></div>
                <ul class="o_sm_people_panel_note" style="margin:0;padding-left:1.1rem"><li t-foreach="pp.insights" t-as="insight" t-key="insight_index"><t t-esc="insight"/></li></ul>
            </article>

            <section class="o_sm_people_top_grid">
                <article t-if="pp.role !== 'employee'" class="o_sm_people_panel">
                    <div class="o_sm_people_panel_heading"><h2>Staffing by Branch</h2><span class="o_sm_people_panel_hint">Actual vs planned staff</span></div>
                    <div class="o_sm_people_staff_list">
                        <div t-foreach="this.pageRows('people_staffing', pp.staffing)" t-as="row" t-key="row.warehouse_id" class="o_sm_people_staff_row">
                            <div class="o_sm_people_staff_info"><strong><t t-esc="row.name"/></strong><span><t t-esc="row.actual"/> staff · <t t-esc="row.planned ? row.planned + ' planned' : 'planned staff not configured'"/> · <t t-esc="row.manager"/></span></div>
                            <div class="o_sm_people_staff_track"><span t-att-class="'o_sm_people_staff_fill ' + this.peopleStaffingClass(row.status)" t-att-style="'width:' + (row.planned ? Math.min(100, row.coverage_pct) : this.peopleBarWidth(row.actual, pp.staffing, 'actual')) + '%'"/></div>
                            <span t-if="row.status === 'covered'" class="o_sm_people_coverage o_sm_people_coverage_good">Covered</span>
                            <span t-elif="row.status === 'understaffed'" class="o_sm_people_coverage o_sm_people_coverage_critical"><t t-esc="row.gap"/> short</span>
                            <span t-else="" class="o_sm_people_coverage o_sm_people_coverage_warn">Not Configured</span>
                        </div>
                    </div><t t-call="strategic_management.ListPager" pagerKey="'people_staffing'" pagerRows="pp.staffing"/>
                    <p class="o_sm_people_panel_note">Planned staff is set per branch warehouse (Inventory › Configuration › Warehouses). Shift-level coverage needs the Planning app, which is not available in Odoo Community.</p>
                </article>

                <article class="o_sm_people_panel">
                    <div class="o_sm_people_panel_heading"><h2>Needs Attention</h2><span class="o_sm_people_count"><t t-esc="pp.attention.length"/> items</span></div>
                    <p t-if="!pp.attention.length" class="o_sm_people_panel_note">No understaffing, repeated late arrivals, absences or overdue follow-ups in this period.</p>
                    <div class="o_sm_people_issue_list">
                        <div t-foreach="this.pageRows('people_attention', pp.attention)" t-as="item" t-key="item_index" class="o_sm_people_issue_row">
                            <div t-att-class="'o_sm_people_issue_icon ' + (item.severity === 'critical' ? 'o_sm_people_issue_red' : 'o_sm_people_issue_amber')"><svg class="o_sm_people_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 22 20H2Z"/><path d="M12 9v5M12 17h.01"/></svg></div>
                            <div class="o_sm_people_issue_copy"><strong><t t-esc="item.title"/></strong><span><t t-esc="item.branch"/> · <t t-esc="item.evidence"/> · Responsible: <t t-esc="item.responsible"/></span></div>
                            <span t-att-class="'o_sm_people_badge ' + (item.severity === 'critical' ? 'o_sm_people_badge_high' : 'o_sm_people_badge_medium')"><t t-esc="item.severity === 'critical' ? 'High' : 'Medium'"/></span>
                        </div>
                    </div><t t-call="strategic_management.ListPager" pagerKey="'people_attention'" pagerRows="pp.attention"/>
                </article>
            </section>

            <section class="o_sm_people_top_grid">
                <article class="o_sm_people_panel">
                    <div class="o_sm_people_panel_heading"><h2>Attendance Pattern</h2><span class="o_sm_people_panel_hint">Exceptions by weekday</span></div>
                    <p t-if="!pp.sources.attendance" class="o_sm_people_panel_note">Not Configured: the Odoo Attendances app is not installed.</p>
                    <div t-else="" class="o_sm_br_bars" role="img" aria-label="Late arrivals and absences by weekday" style="min-height:0">
                        <div t-foreach="pp.attendance_by_weekday" t-as="day" t-key="day.day" class="o_sm_br_bar_row">
                            <span class="o_sm_br_branch_label"><t t-esc="day.day"/></span>
                            <div class="o_sm_br_bar_track" style="display:flex"><i class="o_sm_br_bar_fill o_sm_br_fill_amber" t-att-style="'width:' + this.peopleBarWidth(day.late, pp.attendance_by_weekday, 'late', 'absent') / 2 + '%'" title="Late arrivals"/><i class="o_sm_br_bar_fill" t-att-style="'background:#e5484d;width:' + this.peopleBarWidth(day.absent, pp.attendance_by_weekday, 'late', 'absent') / 2 + '%'" title="Absences"/></div>
                            <strong><t t-esc="day.late"/> late · <t t-esc="day.absent"/> absent</strong>
                        </div>
                    </div>
                </article>
                <article class="o_sm_people_panel">
                    <div class="o_sm_people_panel_heading"><h2>Workload by Person</h2><span class="o_sm_people_panel_hint">Open and overdue follow-ups</span></div>
                    <p t-if="!pp.workload.length" class="o_sm_people_panel_note">No open follow-ups assigned to staff in scope.</p>
                    <div t-else="" class="o_sm_br_bars" role="img" aria-label="Open follow-ups per person" style="min-height:0">
                        <div t-foreach="pp.workload.slice(0, 8)" t-as="row" t-key="row.user_id" class="o_sm_br_bar_row">
                            <span class="o_sm_br_branch_label" t-att-title="row.name + ' · ' + row.branch"><t t-esc="row.name"/></span>
                            <div class="o_sm_br_bar_track"><i t-att-class="'o_sm_br_bar_fill ' + (row.overdue ? 'o_sm_br_fill_amber' : 'o_sm_br_fill_blue')" t-att-style="'width:' + this.peopleBarWidth(row.open, pp.workload, 'open') + '%'"/></div>
                            <strong><t t-esc="row.open"/> open · <t t-esc="row.overdue"/> overdue</strong>
                        </div>
                    </div>
                </article>
            </section>

            <section class="o_sm_people_panel o_sm_people_actions_panel">
                <div class="o_sm_people_panel_heading"><h2>Recent Staff Actions</h2><span class="o_sm_people_panel_hint">Odoo activities: open and completed in period</span></div>
                <p t-if="!pp.actions.length" class="o_sm_people_panel_note">No staff tasks found.</p>
                <div t-else="" class="o_sm_people_table_wrap">
                    <table class="o_sm_people_table">
                        <thead><tr><th>Task</th><th>Record</th><th>Assigned</th><th>Branch</th><th>Due / Done</th><th>Status</th></tr></thead>
                        <tbody>
                            <tr t-foreach="this.pageRows('people_actions', pp.actions)" t-as="action" t-key="action_index">
                                <td><t t-esc="action.task"/></td>
                                <td><t t-esc="action.record"/></td>
                                <td><t t-esc="action.assigned"/></td>
                                <td><t t-esc="action.branch"/></td>
                                <td><t t-esc="this.formatPurchaseDate(action.due_date)"/></td>
                                <td><span t-att-class="'o_sm_people_task_status ' + this.peopleTaskClass(action.status)"><t t-esc="action.status"/></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div><t t-call="strategic_management.ListPager" pagerKey="'people_actions'" pagerRows="pp.actions"/>
            </section>
        </t>
    </div>
    </t>
    <t t-name="strategic_management.PeopleRoles">
        <div class="o_sm_bm o_sm_tasks o_sm_people_roles">
            <t t-set="rl" t-value="this.state.roles"/>
            <p t-if="this.state.rolesError" class="o_sm_bm_notice is-error" role="alert" t-esc="this.state.rolesError"/>
            <article t-elif="rl" class="o_sm_bm_card is-wide">
                <div class="o_sm_bm_card_head"><h2>Roles</h2><span class="o_sm_emp_hint">A role is separate from departments; changing it leaves departments as they are.</span></div>
                <div class="o_sm_task_table_wrap"><table class="o_sm_task_table">
                    <thead><tr><th>Person</th><th>Role</th><th>Branch</th><th>Departments</th><th class="is-action">Action</th></tr></thead>
                    <tbody><tr t-foreach="rl.people" t-as="person" t-key="person.id">
                        <td data-label="Person"><strong t-esc="person.name"/><small t-esc="person.login"/></td>
                        <td data-label="Role" t-esc="person.role_label"/>
                        <td data-label="Branch" t-esc="person.branch || 'None'"/>
                        <td data-label="Departments" t-esc="person.departments.length ? person.departments.join(', ') : 'None'"/>
                        <td class="is-action"><button t-if="person.can_change" type="button" class="o_sm_task_btn" t-on-click="() => this.openRoleForm(person)">Change role</button></td>
                    </tr></tbody>
                </table></div>
            </article>
            <t t-set="rf" t-value="this.state.roleForm"/>
            <div t-if="rf" class="o_sm_req_overlay" t-on-click="() => { this.state.roleForm = null; }">
                <form class="o_sm_req_dialog o_sm_task_form o_sm_role_form" role="dialog" aria-modal="true" aria-label="Change role" t-on-click.stop="() => {}" t-on-submit.prevent="() => this.saveRoleForm()">
                    <header class="o_sm_req_dialog_head"><div><span class="o_sm_req_kicker">Change role</span><h2 t-esc="rf.person.name"/></div><button type="button" class="o_sm_req_close" aria-label="Close" t-on-click="() => { this.state.roleForm = null; }">×</button></header>
                    <div class="o_sm_req_dialog_body">
                        <label>Role<select required="required" t-on-change="(ev) => { rf.role = ev.target.value; }"><option value="">Choose a role</option><option t-foreach="rl.roles" t-as="option" t-key="option.id" t-att-value="option.id" t-att-selected="option.id === rf.role" t-esc="option.name"/></select></label>
                        <label t-if="rf.role === 'branch_manager' or rf.role === 'employee'">Branch<select t-att-required="rf.role === 'branch_manager'" t-on-change="(ev) => { rf.warehouse_id = ev.target.value; }"><option value="">Choose a branch</option><option t-foreach="rl.branches" t-as="branch" t-key="branch.id" t-att-value="branch.id" t-att-selected="('' + branch.id) === rf.warehouse_id" t-esc="branch.name"/></select></label>
                        <p t-if="rf.role === 'admin'" class="o_sm_bm_notice">Admin has no branch or department data. Point of Sale, Inventory, Purchase, Sales, Accounting, Manufacturing and HR app access is set aside while they are Admin, and given back when their role changes.</p>
                    </div>
                    <footer class="o_sm_req_dialog_foot"><button type="submit" class="o_sm_req_btn is-solid" t-att-disabled="this.state.roleSaving">Save</button></footer>
                </form>
            </div>
        </div>
    </t>
</templates>
