<?xml version="1.0" encoding="UTF-8"?>
<!-- Sales. Called from strategic_management.NavigationShell. -->
<templates xml:space="preserve">
    <t t-name="strategic_management.SalesPage">
    <div class="o_sm_sales_finance">
        <header class="o_sm_sf_header">
            <div class="o_sm_sf_title_block">
                <h1>Sales &amp; Finance</h1>
                <p>Track sales performance and financial insights across your café branches.</p>
                <span class="o_sm_sf_preview_badge">POS-backed figures where available</span>
            </div>
            <div class="o_sm_sf_filters">
    <label class="o_sm_sf_filter">
        <span>From</span>
        <input type="date" t-att-value="this.state.dateStart"
               t-on-change="this.onStartDateChanged"/>
    </label>
    <label class="o_sm_sf_filter">
        <span>To</span>
        <input type="date" t-att-value="this.state.dateEnd"
               t-on-change="this.onEndDateChanged"/>
    </label>
    <label class="o_sm_sf_filter">
        <span>Branch</span>
        <select t-att-value="this.branchSelectValue"
                t-on-change="this.onWarehouseChanged">
            <option t-if="this.state.data.role === 'head_office'" value="all">All Branches</option>
            <t t-foreach="this.state.data.branch_options || []" t-as="branch" t-key="branch.id">
                <option t-att-value="branch.id"><t t-esc="branch.name"/></option>
            </t>
        </select>
    </label>
</div>
</header>
        <t t-call="strategic_management.AreaGoals" areaKey="'sales_finance'"/>

        <section class="o_sm_sf_summary o_sm_ledger" aria-label="Sales summary preview">
            <article t-att-class="'o_sm_sf_metric' + (this.state.data.drill and this.state.data.drill.sales ? ' is-drill' : '')" t-att-role="this.state.data.drill and this.state.data.drill.sales ? 'button' : false" t-att-tabindex="this.state.data.drill and this.state.data.drill.sales ? 0 : false" t-on-click="() => this.openDrill(this.state.data.drill and this.state.data.drill.sales)" t-on-keydown="(ev) => this.onDrillKey(ev, this.state.data.drill and this.state.data.drill.sales)">
                <div class="o_sm_sf_metric_icon o_sm_sf_icon_sales"><svg class="o_sm_sf_ui_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 9h.01M18 15h.01"/></svg></div>
                <div class="o_sm_sf_metric_copy">
    <span>Total Sales (excl. tax)</span>
    <strong><t t-esc="this.formatCurrency(this.state.data.sales)"/></strong>
    <small>POS sales and customer invoices for the selected period</small>
    <svg t-if="this.sparkPoints(this.state.data.sales_trend, 'sales')" class="o_sm_spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true"><polyline t-att-points="this.sparkPoints(this.state.data.sales_trend, 'sales')"/></svg>
</div>
            </article>
            <article t-att-class="'o_sm_sf_metric' + (this.state.data.drill and this.state.data.drill.orders ? ' is-drill' : '')" t-att-role="this.state.data.drill and this.state.data.drill.orders ? 'button' : false" t-att-tabindex="this.state.data.drill and this.state.data.drill.orders ? 0 : false" t-on-click="() => this.openDrill(this.state.data.drill and this.state.data.drill.orders)" t-on-keydown="(ev) => this.onDrillKey(ev, this.state.data.drill and this.state.data.drill.orders)">
                <div class="o_sm_sf_metric_icon o_sm_sf_icon_orders"><svg class="o_sm_sf_ui_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.3 11.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 1.9-1.4L22 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg></div>
                <div class="o_sm_sf_metric_copy">
    <span>Total Orders</span>
    <strong><t t-esc="this.formatNumber(this.state.data.order_count)"/></strong>
    <small>POS orders and customer invoices in the selected period</small>
</div>
            </article>
            <article t-att-class="'o_sm_sf_metric' + (this.state.data.drill and this.state.data.drill.sales ? ' is-drill' : '')" t-att-role="this.state.data.drill and this.state.data.drill.sales ? 'button' : false" t-att-tabindex="this.state.data.drill and this.state.data.drill.sales ? 0 : false" t-on-click="() => this.openDrill(this.state.data.drill and this.state.data.drill.sales)" t-on-keydown="(ev) => this.onDrillKey(ev, this.state.data.drill and this.state.data.drill.sales)">
                <div class="o_sm_sf_metric_icon o_sm_sf_icon_average"><svg class="o_sm_sf_ui_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v5h4M9 12h7M9 16h7"/></svg></div>
                <div class="o_sm_sf_metric_copy">
    <span>Average Order Value</span>
    <strong><t t-esc="this.formatCurrency(this.averageOrderValue())"/></strong>
    <small>Sales total divided by eligible POS order count</small>
</div>
            </article>
            <article t-att-class="'o_sm_sf_metric' + (this.state.data.drill and this.state.data.drill.discounts_refunds ? ' is-drill' : '')" t-att-role="this.state.data.drill and this.state.data.drill.discounts_refunds ? 'button' : false" t-att-tabindex="this.state.data.drill and this.state.data.drill.discounts_refunds ? 0 : false" t-on-click="() => this.openDrill(this.state.data.drill and this.state.data.drill.discounts_refunds)" t-on-keydown="(ev) => this.onDrillKey(ev, this.state.data.drill and this.state.data.drill.discounts_refunds)">
                <div class="o_sm_sf_metric_icon o_sm_sf_icon_adjustments"><svg class="o_sm_sf_ui_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="2"/><circle cx="17" cy="17" r="2"/><path d="m5 19 14-14"/></svg></div>
                <div class="o_sm_sf_metric_copy">
    <span>Discounts &amp; Refunds</span>
    <t t-set="dr" t-value="this.state.data.discounts_refunds"/>
    <strong><t t-esc="dr ? this.formatCurrency(dr.discount_total + dr.refund_total) : 'Not available'"/></strong>
    <small t-if="dr"><t t-esc="this.formatCurrency(dr.discount_total)"/> discounts · <t t-esc="this.formatCurrency(dr.refund_total)"/> refunds (<t t-esc="dr.refund_count"/>)</small>
    <small t-else="">POS discount and refund data could not be read</small>
</div>
            </article>
        </section>
        <div t-if="this.state.data.messages and this.state.data.messages.length" class="o_sm_br_notice"><t t-esc="this.state.data.messages[0]"/></div>

        <section class="o_sm_sf_grid o_sm_sf_grid_top">
            <article class="o_sm_sf_panel o_sm_sf_trend_panel">
                <div class="o_sm_sf_panel_heading"><h2>Sales Trend</h2><div class="o_sm_sf_toggle">
    <button type="button" t-att-class="this.state.trendGranularity === 'day' ? 'is-active' : ''" t-on-click="() => this.setTrendGranularity('day')">Daily</button>
    <button type="button" t-att-class="this.state.trendGranularity === 'week' ? 'is-active' : ''" t-on-click="() => this.setTrendGranularity('week')">Weekly</button>
    <button type="button" t-att-class="this.state.trendGranularity === 'month' ? 'is-active' : ''" t-on-click="() => this.setTrendGranularity('month')">Monthly</button>
</div></div>
                <div class="o_sm_sf_legend">
    <span><i class="o_sm_sf_legend_current"/>POS sales and customer invoices for the selected period</span>
</div>
                <svg class="o_sm_sf_trend_chart" viewBox="0 0 600 190"
     role="img" aria-label="Monthly POS sales trend">
    <line x1="48" y1="25" x2="590" y2="25"/>
    <line x1="48" y1="62" x2="590" y2="62"/>
    <line x1="48" y1="99" x2="590" y2="99"/>
    <line x1="48" y1="136" x2="590" y2="136"/>
    <line x1="48" y1="160" x2="590" y2="160" class="o_sm_sf_axis"/>
    <line x1="48" y1="25" x2="48" y2="160" class="o_sm_sf_axis"/>
    <text x="40" y="29" text-anchor="end"><t t-esc="this.formatCompactCurrency(this.salesTrendMax())"/></text>
    <text x="40" y="66" text-anchor="end"><t t-esc="this.formatCompactCurrency(this.salesTrendMax() * 0.75)"/></text>
    <text x="40" y="103" text-anchor="end"><t t-esc="this.formatCompactCurrency(this.salesTrendMax() * 0.5)"/></text>
    <text x="40" y="140" text-anchor="end"><t t-esc="this.formatCompactCurrency(this.salesTrendMax() * 0.2)"/></text>
    <text x="40" y="164" text-anchor="end">0</text>
    <polyline t-att-points="this.salesTrendPoints()" class="o_sm_sf_current_line"/>
    <t t-foreach="this.state.data.sales_trend || []" t-as="point" t-key="point.month_key">
        <circle t-att-cx="this.salesTrendX(point_index, this.state.data.sales_trend.length)"
                t-att-cy="this.salesTrendY(point.sales)" r="3.5"
                class="o_sm_sf_sales_point"/>
        <circle t-if="point.drill" class="o_sm_sf_point_hit" r="10"
                t-att-cx="this.salesTrendX(point_index, this.state.data.sales_trend.length)" t-att-cy="this.salesTrendY(point.sales)"
                t-att-aria-label="point.label + ': open its sales'" t-att-role="point.drill ? 'button' : false" t-att-tabindex="point.drill ? 0 : false" t-on-click="() => this.openDrill(point.drill)" t-on-keydown="(ev) => this.onDrillKey(ev, point.drill)"><title t-esc="point.label + ': ' + this.formatCurrency(point.sales) + ', click to open'"/></circle>
        <text t-if="point_index === 0 || point_index === this.state.data.sales_trend.length - 1 || (point_index % this.trendLabelStep() === 0 and this.state.data.sales_trend.length - 1 - point_index >= this.trendLabelStep() / 2)" t-att-x="this.salesTrendX(point_index, this.state.data.sales_trend.length)" y="181" text-anchor="middle"><t t-esc="point.label"/></text>
    </t>
</svg>
            </article>
            <article class="o_sm_sf_panel o_sm_sf_branch_panel">
                <div class="o_sm_sf_panel_heading"><h2>Sales by Branch</h2><select class="o_sm_sf_select_static o_sm_sf_select_control" t-att-value="this.state.branchMetric" t-on-change="this.onBranchMetricChanged" aria-label="Branch comparison metric"><option value="sales">Sales Amount</option><option value="orders">Order Count</option><option value="average_order_value">Average Order Value</option></select></div>
                <div class="o_sm_sf_branch_rows">
    <t t-foreach="this.state.data.branch_sales || []" t-as="branch" t-key="branch.branch_id || branch.name">
        <div t-att-class="'o_sm_sf_branch_row' + (branch.drill ? ' is-drill' : '')" t-att-role="branch.drill ? 'button' : false" t-att-tabindex="branch.drill ? 0 : false" t-on-click="() => this.openDrill(branch.drill)" t-on-keydown="(ev) => this.onDrillKey(ev, branch.drill)">
            <span><t t-esc="branch.name"/></span>
            <div class="o_sm_sf_track">
                <i t-att-style="'width:' + this.branchBarWidth(branch) + '%'"/>
            </div>
            <strong><t t-esc="this.formatBranchMetric(branch)"/></strong>
        </div>
    </t>
    <div t-if="!(this.state.data.branch_sales || []).length" class="o_sm_sf_empty_state">
        No branch sales are available for this period.
    </div>
</div>
</article>
        </section>

        <section class="o_sm_sf_grid o_sm_sf_grid_middle">
            <article class="o_sm_sf_panel o_sm_sf_products_panel">
                <div class="o_sm_sf_panel_heading"><h2>Best-Selling Products</h2><select class="o_sm_sf_select_static o_sm_sf_select_control" t-att-value="this.state.topProductLimit" t-on-change="this.onTopProductLimitChanged" aria-label="Number of top-selling products"><option value="5">Top 5</option><option value="10">Top 10</option></select></div>
                <div class="o_sm_sf_table_wrap"><table class="o_sm_sf_table"><thead><tr><th>#</th><th>Product</th><th>Category</th><th>Quantity Sold</th><th>Revenue</th></tr></thead><tbody>
    <t t-foreach="this.state.data.top_products || []" t-as="product" t-key="product.product_id">
        <tr t-att-class="product.drill ? 'is-drill' : ''" t-att-role="product.drill ? 'button' : false" t-att-tabindex="product.drill ? 0 : false" t-on-click="() => this.openDrill(product.drill)" t-on-keydown="(ev) => this.onDrillKey(ev, product.drill)">
            <td><t t-esc="product_index + 1"/></td>
            <td><span class="o_sm_sf_product_icon">●</span><t t-esc="product.name"/></td>
            <td><t t-esc="product.category || 'Not available'"/></td>
            <td><t t-esc="this.formatNumber(product.quantity)"/></td>
            <td><t t-esc="this.formatCurrency(product.revenue)"/></td>
        </tr>
    </t>
    <tr t-if="!(this.state.data.top_products || []).length">
        <td colspan="5">No POS product sales are available for this period.</td>
    </tr>
</tbody></table></div>
            </article>
            <article class="o_sm_sf_panel">
    <div class="o_sm_sf_panel_heading"><h2>Sales by Category</h2></div>
    <div class="o_sm_sf_donut_layout">
        <div class="o_sm_sf_donut o_sm_sf_category_donut" t-att-style="this.categoryDonutStyle()" role="img" aria-label="POS sales by product category">
            <div class="o_sm_sf_donut_hole">
                <strong><t t-esc="this.formatCurrency(this.categoryTotal())"/></strong>
                <span>Total Sales</span>
            </div>
        </div>
        <div class="o_sm_sf_donut_legend">
            <t t-if="(this.state.data.sales_by_category || []).length">
                <t t-foreach="this.state.data.sales_by_category || []" t-as="category" t-key="category.category_id || category.name">
                    <div t-att-class="category.drill ? 'is-drill' : ''" t-att-role="category.drill ? 'button' : false" t-att-tabindex="category.drill ? 0 : false" t-on-click="() => this.openDrill(category.drill)" t-on-keydown="(ev) => this.onDrillKey(ev, category.drill)">
                        <i t-att-style="'background:' + this.categoryColor(category_index)"/>
                        <span><t t-esc="category.name"/></span>
                        <b><t t-esc="this.formatNumber(category.percentage)"/>%</b>
                        <strong><t t-esc="this.formatCurrency(category.sales)"/></strong>
                    </div>
                </t>
            </t>
            <p t-else="">No POS product-category sales are available for this period.</p>
        </div>
    </div>
</article>
        </section>

        <section class="o_sm_sf_grid o_sm_sf_grid_bottom">
            <article class="o_sm_sf_panel">
    <div class="o_sm_sf_panel_heading"><h2>Sales by Hour</h2></div>
    <div class="o_sm_sf_hour_chart">
        <div class="o_sm_sf_hour_y"><span><t t-esc="this.salesHourAxisLabel(1)"/></span><span><t t-esc="this.salesHourAxisLabel(0.66)"/></span><span><t t-esc="this.salesHourAxisLabel(0.33)"/></span><span>0</span></div>
        <div class="o_sm_sf_hour_plot">
            <div class="o_sm_sf_hour_grid"><i/><i/><i/><i/></div>
            <div class="o_sm_sf_hour_bars">
    <t t-foreach="this.state.data.sales_by_hour || []" t-as="hour" t-key="hour.hour">
        <div t-att-title="hour.full_label + ': ' + this.formatNumber(hour.sales)">
            <i t-att-style="'height:' + this.salesHourBarHeight(hour.sales) + '%'"/>
            <span><t t-esc="hour.label"/></span>
        </div>
    </t>
    <p t-if="!(this.state.data.sales_by_hour || []).length">Hourly POS sales are unavailable for this period.</p>
</div>
        </div>
    </div>
</article>
            
        </section>
    </div>
    </t>
</templates>
