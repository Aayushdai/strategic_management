<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- See control_panel_back.js. -->
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]" position="before">
            <button t-if="this.smShowBack" type="button" class="o_sm_back o_sm_back_cp" t-on-click="() => this.smBack()">
                <span aria-hidden="true">←</span> Back
            </button>
        </xpath>
    </t>
</templates>
